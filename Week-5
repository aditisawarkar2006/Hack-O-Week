print("Intent Chatbot")

# function to detect intent
def get_intent(query):
    if "fee" in query:
        return "fees"
    elif "hostel" in query:
        return "hostel"
    elif "admission" in query:
        return "admission"
    else:
        return "unknown"

while True:
    query = input("You: ").lower()

    if query == "exit":
        print("Bot: Goodbye!")
        break

    intent = get_intent(query)

    if intent == "fees":
        print("Bot: Fees is 50000 per year")

    elif intent == "hostel":
        print("Bot: Hostel is available")

    elif intent == "admission":
        print("Bot: Admission starts in June")

    else:
        print("Bot: Sorry, I don't understand")
